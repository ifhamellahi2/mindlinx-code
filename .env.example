# Local development only. Copy to .env and replace the password.
# Placeholders only - never commit real credentials.
POSTGRES_DB=mindlinx
POSTGRES_USER=mindlinx
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mindlinx:change-me@localhost:5433/mindlinx

# Better Auth (server-only). Generate a real secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-characters
BETTER_AUTH_URL=http://localhost:3000
